{
  "_comment": [
    "Logistic-regression weights for cue confidence. Hand-set priors, expressing",
    "domain knowledge about what makes each cue type trustworthy. They are the",
    "starting point, not the destination: scripts/refit_weights.py refits them",
    "from user accept/reject/drag feedback collected by the editor. Bias values",
    "are negative so that a candidate with no supporting evidence scores low.",
    "Interpretation: a weight of 1.0 on a 0/1 feature means observing it roughly",
    "trebles the odds that a DJ keeps the cue."
  ],
  "_default": {
    "bias": -0.9,
    "weights": {
      "on_downbeat": 0.9, "on_phrase": 0.7, "grid_confidence": 0.6,
      "downbeat_confidence": 0.4, "section_confidence": 0.8
    }
  },
  "drop": {
    "bias": -1.1,
    "weights": {
      "energy_jump": 2.2, "low_jump": 1.6, "density_jump": 0.9,
      "energy_pct": 1.2, "low_energy_pct": 1.0, "onset_density_pct": 0.5,
      "preceded_by_buildup": 1.1, "buildup_bars": 0.7,
      "on_downbeat": 1.0, "on_phrase": 0.8,
      "grid_confidence": 0.5, "downbeat_confidence": 0.5, "section_confidence": 0.9
    }
  },
  "pre_drop": {
    "bias": -1.0,
    "weights": {
      "energy_jump": 1.4, "low_jump": 0.9, "preceded_by_buildup": 1.5,
      "buildup_bars": 0.8, "on_downbeat": 1.0, "on_phrase": 0.6,
      "grid_confidence": 0.5, "section_confidence": 0.8
    }
  },
  "buildup": {
    "bias": -1.0,
    "weights": {
      "energy_slope": 1.8, "high_energy_pct": 0.9, "onset_density_pct": 0.7,
      "resolves_to_drop": 1.6, "next_energy_jump": 1.2, "length_bars": 0.5,
      "on_downbeat": 0.8, "on_phrase": 0.9,
      "grid_confidence": 0.4, "section_confidence": 0.8
    }
  },
  "breakdown": {
    "bias": -1.0,
    "weights": {
      "bass_drop_out": 1.9, "density_drop": 1.0, "low_energy_pct": -1.2,
      "energy_pct": -0.6, "length_bars": 0.5,
      "on_downbeat": 0.8, "on_phrase": 0.9,
      "grid_confidence": 0.4, "section_confidence": 0.9
    }
  },
  "intro": {
    "bias": -0.8,
    "weights": {
      "energy_pct": -0.8, "length_bars": 0.7,
      "on_downbeat": 0.9, "on_phrase": 1.0,
      "grid_confidence": 0.5, "section_confidence": 0.8
    }
  },
  "outro": {
    "bias": -0.8,
    "weights": {
      "energy_pct": -0.7, "position": 0.9, "length_bars": 0.6,
      "on_downbeat": 0.9, "on_phrase": 1.0,
      "grid_confidence": 0.5, "section_confidence": 0.8
    }
  },
  "mix_in": {
    "bias": -1.2,
    "weights": {
      "has_drums": 1.7, "stable_energy": 1.4, "no_vocals": 1.0,
      "long_enough": 1.3, "not_too_loud": 0.6,
      "on_downbeat": 0.9, "on_phrase": 1.2,
      "grid_confidence": 0.7, "section_confidence": 0.7
    }
  },
  "mix_out": {
    "bias": -1.2,
    "weights": {
      "has_drums": 1.7, "stable_energy": 1.4, "no_vocals": 0.9,
      "long_enough": 1.3, "position": 0.8,
      "on_downbeat": 0.9, "on_phrase": 1.2,
      "grid_confidence": 0.7, "section_confidence": 0.7
    }
  },
  "vocal_in": {
    "bias": -1.3,
    "weights": {
      "vocal_confidence": 2.4, "vocal_length": 1.1,
      "in_labelled_vocal_section": 0.9,
      "on_downbeat": 1.0, "on_phrase": 0.5, "grid_confidence": 0.4
    }
  },
  "vocal_out": {
    "bias": -1.4,
    "weights": {
      "vocal_confidence": 2.2, "vocal_length": 1.0,
      "on_downbeat": 0.9, "on_phrase": 0.4, "grid_confidence": 0.4
    }
  },
  "chorus": {
    "bias": -1.1,
    "weights": {
      "energy_pct": 1.2, "vocal_ratio": 1.8,
      "on_downbeat": 0.9, "on_phrase": 1.0, "section_confidence": 0.9
    }
  },
  "fx": {
    "bias": -1.6,
    "weights": {
      "transition_size": 1.8, "into_drop": 1.4,
      "on_downbeat": 0.9, "on_phrase": 0.7, "section_confidence": 0.6
    }
  },
  "loop": {
    "bias": -1.0,
    "weights": {
      "seamlessness": 2.4, "internal_stability": 1.6, "loop_on_phrase": 1.1,
      "has_drums": 0.9, "vocal_cut": -1.8, "grid_confidence": 0.6
    }
  }
}
